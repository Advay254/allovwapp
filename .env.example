# AllovWapp environment variables. Copy these into the Render dashboard (Environment tab).
# Never commit a real .env file. Never share these values.

# Required. Postgres connection string. Any sslmode or ssl parameter in it is ignored on purpose.
# Use DATABASE_SSL instead. With a pooler such as Supabase, use session mode on port 5432.
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Optional. require (default): encrypted, certificate not verified. verify: encrypted and verified.
# off: no encryption (only for a trusted private network).
DATABASE_SSL=require

# Optional. CA certificate, used only when DATABASE_SSL=verify. Accepts the PEM as is,
# on one line with \n between lines, or base64 encoded.
DATABASE_CA_CERT=

# Optional. Maximum database connections. Default 5.
DATABASE_POOL_MAX=5

# Required. At least 32 characters (64 hex characters recommended). It protects login throttle
# keys now and will encrypt stored credentials later. Never change it after first use.
ENCRYPTION_KEY=replace-with-64-random-hex-characters

# Required. Username of the first owner account (letters, digits, dot, underscore, at sign, hyphen).
ADMIN_USERNAME=owner

# Required. Password of the owner account. At least 12 characters, 16 or more recommended.
# Changing this value and redeploying resets the owner password and signs out all sessions.
ADMIN_PASSWORD=replace-with-a-long-password

# Optional. Private path prefix for the sign in page and dashboard. Default /app.
ADMIN_PATH=/app

# Required. Public URL of the service, for example https://allovwapp.onrender.com
BASE_URL=https://allovwapp.onrender.com

# Optional. Port to listen on. Default 3000. Render sets this for you.
PORT=3000

# Optional. all (default) runs the API and the worker in one process. api or worker run one role.
ALLOV_ROLE=all

# Optional. Days to keep audit log entries. Default 90.
AUDIT_RETENTION_DAYS=90

# Optional. warn (default), error, info or debug.
LOG_LEVEL=warn
