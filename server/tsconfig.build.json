{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": [
    "main.ts",
    "entry-api.ts",
    "entry-worker.ts",
    "config/*.ts",
    "db/*.ts",
    "http/*.ts",
    "lib/*.ts",
    "auth/*.ts",
    "workspaces/*.ts",
    "audit/*.ts",
    "system/*.ts"
  ],
  "exclude": ["dist", "node_modules", "test"]
}
